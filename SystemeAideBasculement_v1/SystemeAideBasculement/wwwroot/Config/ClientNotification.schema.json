{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$defs": {
    "ClientNotification": {
      "type": "object",
      "required": [ "ProfileName", "Status", "Site" ],
      "properties": {
        "ProfileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "Status": {
          "type": "string",
          "pattern": "^(?i)(connected|disconnected)$"
        },
        "HostNames": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "Site": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "additionalProperties": false
    }
  },

  "anyOf": [
    { "$ref": "#/$defs/ClientNotification" },
    {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ClientNotification"
      }
    }
  ]
}