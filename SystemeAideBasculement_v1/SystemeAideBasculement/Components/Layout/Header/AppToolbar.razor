@using SystemeAideBasculement.Components.Layout
@using SystemeAideBasculement.Components.Layout.Security
@using SystemeAideBasculement.Services.Security
@using SystemeAideBasculement.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@implements IDisposable

<div class="app-toolbar" role="navigation" aria-label="Actions principales">
    <div class="toolbar-left">
        <span class="toolbar-label">Options d'affichage :</span>
        <div class="toggle-group">
            <button class="toggle-btn @(ViewMode == DashboardViewMode.Profile ? "active" : "")"
                    type="button"
                    @onclick="() => ChangeView(DashboardViewMode.Profile)">
                Option 1 = Vue par profil
            </button>

            <button class="toggle-btn @(ViewMode == DashboardViewMode.PEX ? "active" : "")"
                    type="button"
                    @onclick="() => ChangeView(DashboardViewMode.PEX)">
                Option 2 = Vue par PEX
            </button>
        </div>
    </div>

    <div class="toolbar-right">
        <div class="clock">@CurrentTime</div>
        <UserMenu IsAuthenticated="@IsAuthenticated"
                  DisplayName="@DisplayName"
                  OnLogin="OpenLogin"
                  OnLogout="Logout" />
        <LoginModal IsOpen="@ShowLogin"
                    OnClose="CloseLogin"
                    OnLoginSuccess="OnLoginSuccess" />

    </div>
</div>

@code {
    [Parameter] public DashboardViewMode ViewMode { get; set; } = DashboardViewMode.Profile;
    [Parameter] public EventCallback<DashboardViewMode> OnViewModeChanged { get; set; }
    [Parameter] public EventCallback<UserInfo?> OnCurrentUserChanged { get; set; }

    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private SabAuthStateProvider AuthProvider { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    private string CurrentTime { get; set; } = DateTime.Now.ToString("HH:mm:ss");
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private UserInfo? _userInfo;

    // Authentication state (replace with real auth)
    private bool IsAuthenticated { get; set; } = false;
    private bool ShowLogin { get; set; } = false;
    private string DisplayName { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        // abonnement event
        AuthStateProvider.AuthenticationStateChanged += OnAuthChanged;

        // récupère état initial (important pour F5)
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        UpdateUserState(authState.User);

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = UpdateClockAsync();
    }

    private async Task LoadAuthStateAsync()
    {

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        UpdateUserState(authState.User);
    }

    private void OnAuthChanged(Task<AuthenticationState> task)
    {

        _ = InvokeAsync(async () =>
         {
             var authState = await task;

             UpdateUserState(authState.User);
             StateHasChanged();
         });
    }

    private void UpdateUserState(ClaimsPrincipal user)
    {
        IsAuthenticated = user.Identity?.IsAuthenticated == true;

        if (IsAuthenticated)
        {
            _userInfo = user.ToUserInfo();

            DisplayName = _userInfo.DisplayName ??
                          _userInfo.Username ?? "";
        }
        else
        {
            IsAuthenticated = false;
            DisplayName = "";
            _userInfo = null;
        }

        // Fire and forget the callback
        _ = OnCurrentUserChanged.InvokeAsync(_userInfo);
    }


    private async Task UpdateClockAsync()
    {

        var timer = _timer;
        var ct = _cts?.Token ?? CancellationToken.None;

        if (timer == null)
            return;

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(() =>
                {
                    CurrentTime = DateTime.Now.ToString("HH:mm:ss");
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // expected on dispose
        }
    }

    private Task ChangeView(DashboardViewMode mode)
    {
        if (ViewMode == mode)
            return Task.CompletedTask;

        ViewMode = mode;
        return OnViewModeChanged.InvokeAsync(mode);
    }

    private void OpenLogin()
    {
        ShowLogin = true;
    }

    private void CloseLogin()
    {
        ShowLogin = false;
    }

    private async Task Logout()
    {
        // 1) Tentative B (browser fetch)
        var ok = await JS.InvokeAsync<bool>("sabAuth_logout");

        if (ok)
        {
            // UI immédiate : on notifie le provider
            AuthProvider.NotifyLogout();
            return;
        }

        // 2) Fallback A : navigation "hard" (GET) pour forcer nettoyage cookie
        // => nécessite le GET /api/auth/logout (ou /Account/Logout)
        Nav.NavigateTo("/api/auth/logout", forceLoad: true);
    }

    private void OnLoginSuccess(string username)
    {
        ShowLogin = false;
    }

    public void Dispose()
    {
        try
        {
             AuthStateProvider.AuthenticationStateChanged -= OnAuthChanged;

            _cts?.Cancel();
            _timer?.Dispose();
            _cts?.Dispose();
        }
        catch { }

    }
}