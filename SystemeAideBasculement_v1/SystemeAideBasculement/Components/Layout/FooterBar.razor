@using SystemeAideBasculement.Components.Layout.Common

<div class="footer-bar">
    <ButtonAction DisplayText="🗂 Ouvrir"
                  TooltipText="Ouvrir une liste de documents à consulter."
                  CanEdit="CanEdit"
                  OnClick="OnOpenClicked" />

    <div class="footer-text">
        Consulter la procédure complète de basculement entre CCP et CCR
    </div>
</div>

@code {
    [Parameter] public bool CanEdit { get; set; } = false;
    [Parameter] public EventCallback OnOpen { get; set; }

    private async Task OnOpenClicked()
    {
        if (OnOpen.HasDelegate)
        {
            await OnOpen.InvokeAsync();
        }
    }
}