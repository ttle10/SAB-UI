@using SystemeAideBasculement.Models

@if (DisplayException != null)
{
    @if (DisplayException is InfoException)
    {
        <div class="alert">
            <span class="closebtn"
                  @onclick="Close">&times;</span>
            <strong>Attention!</strong>: @DisplayException.DisplayMessage
        </div>
    }
	else if (DisplayException is WarningException)
    {
        <span class="btn-close"
              title="@DisplayException.DisplayMessage"
              @onclick="Close">1
        </span>
    }
    else
    {
        <span>: @DisplayException.DisplayMessage</span>
    }
}

@code {
    [Parameter] public ICustomMessage? DisplayException { get; set; }

    [Parameter] public bool Closable { get; set; } = true;

    [Parameter] public bool ShowRetry { get; set; } = false;

    [Parameter] public bool ShowBtnRetry { get; set; } = false;

    [Parameter] public EventCallback OnRetry { get; set; }

    public void SetMessage(ICustomMessage? ex)
    {
        if (ex != null)
        {
            DisplayException = ex.ToObject();
        }
        else
        {
            DisplayException = null;
        }
        StateHasChanged();
    }


    private async Task OnRetryClicked()
    {
        if (OnRetry.HasDelegate)
        {
            await OnRetry.InvokeAsync();
        }
        
    }

    private void Close()
    {
        DisplayException = null;
        StateHasChanged();
    }
}