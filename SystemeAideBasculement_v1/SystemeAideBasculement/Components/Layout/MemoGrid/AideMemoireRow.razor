@using SystemeAideBasculement.Models

<tr>
    <!-- Étape -->
    <td class="col-step aide-memoire-cell">
        @if (Etape.Id == EtapeEnEdition?.Id)
        {
            <AutoResizeTextarea Value="@EtapeEnEdition.Step"
                                ValueChanged="@(v => EtapeEnEdition.Step = v)"
                                MaxLength="200"
                                ShowCounter="false"
                                OnCtrlEnter="() => OnSave.InvokeAsync(EtapeEnEdition)" />
        }
        else
        {
            @Etape.Step
        }
    </td>

    <!-- Complété (TOUJOURS éditable) -->
    <td class="col-complete">
        <input type="checkbox" @bind="Etape.IsCompleted" />
    </td>

    <!-- Initiales (TOUJOURS éditable) -->
    <td class="col-initiales">
        <input class="input-initiales"
               @bind="Etape.Initiales" 
               maxlength="7" />
    </td>

    <!-- Actions -->
    <td class="col-actions">
        @if (Etape.Id == EtapeEnEdition?.Id)
        {
            <button class="btn-icon"
                    @onclick="() => OnSave.InvokeAsync(EtapeEnEdition)">💾</button>
            <button class="btn-icon"
                    @onclick="() => OnCancel.InvokeAsync()">✖</button>
        }
        else
        {
            <button class="btn-icon"
                    @onclick="() => OnEdit.InvokeAsync(Etape)">✎</button>
            <button class="btn-icon"
                    @onclick="() => OnDelete.InvokeAsync(Etape)">🗑</button>
        }
    </td>
</tr>

@code {
    [Parameter] public AideMemoireModel Etape { get; set; } = default!;
    [Parameter] public AideMemoireModel? EtapeEnEdition { get; set; }

    [Parameter] public EventCallback<AideMemoireModel> OnEdit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<AideMemoireModel?> OnSave { get; set; }
    [Parameter] public EventCallback<AideMemoireModel> OnDelete { get; set; }
}