<tr>
    @if (AjoutEnCours)
    {
        <!-- Étape -->
        <td class="col-step">
            <AutoResizeTextarea Value="@NouvelleEtape"
                                ValueChanged="OnNouvelleEtapeChanged"
                                MaxLength="200"
                                Placeholder="Nouvelle étape..."
                                ShowCounter="false"
                                OnCtrlEnter="OnAdd" />
        </td>

        <!-- Complété -->
        <td class="col-completed"></td>

        <!-- Initiales -->
        <td class="col-initials">
        </td>
        <!-- Actions -->
        <td class="col-actions">
            <button class="btn-icon"
                    disabled="@string.IsNullOrWhiteSpace(NouvelleEtape)"
                    @onclick="() => OnAdd.InvokeAsync()">
                   💾
            </button>
            <button class="btn-icon"
                    @onclick="() => OnCancelAdd.InvokeAsync()">
                ✖
            </button>
        </td>
    }
    else
    {
        <td colspan="4">
            <button class="btn-add" @onclick="() => OnStartAdd.InvokeAsync()">
                ＋ Ajouter une nouvelle étape…
            </button>
        </td>
    }
</tr>

@code {
    [Parameter] public bool AjoutEnCours { get; set; }
    [Parameter] public string NouvelleEtape { get; set; } = "";

    [Parameter] public EventCallback OnStartAdd { get; set; }
    [Parameter] public EventCallback OnCancelAdd { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public EventCallback<string?> OnNouvelleEtapeChanged { get; set; }
}