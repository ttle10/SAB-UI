@using SystemeAideBasculement.Components.Layout.MemoGrid
@using SystemeAideBasculement.Shared

<section class="panel">
    <AideMemoire CanEdit="@CanEdit()" />
    <div />
    <MemoToolbar CanEdit="@CanEdit()" />
</section>
@code {
    [Parameter] public UserInfo? UserInfo { get; set; } = null;

    private bool CanEdit()
    {
        if (UserInfo == null)
            return false;

        var sab = new SABUnit();
        return sab.IsValidRole(UserInfo.Role);
    }
}