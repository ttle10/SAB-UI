@using System.Reflection
@using SystemeAideBasculement.Components.Layout
@using SystemeAideBasculement.Components.Layout.Header
@using SystemeAideBasculement.Components.Layout.ProfileGrid
@using SystemeAideBasculement.Components.Layout.ReminderGrid
@using SystemeAideBasculement.Services
@using SystemeAideBasculement.Shared

@inject NavigationManager Navigation
@inject NotificationService Notifications

<div class="dashboard-shell">
    <AppHeader ViewMode="@ViewMode"
               OnViewModeChanged="@SetViewMode"
               OnCurrentUserChanged="@HandleUserChanged" />
    <div class="content-row">
        <div class="profiles-column">
            <ProfilesPanel ViewMode="@ViewMode" />
        </div>
        <div class="reminder-column">
			<ReminderPanel CurrentUserInfo="@CurrentUserInfo"/>
        </div>
    </div>
    <div class="dashboard-bottom">
        <!-- <FooterBar CanEdit="@CanEdit()" /> -->
        <OptionNote Text="@OptionNoteText" />
        <div class="dashboard-version">
            Version @AppVersion
        </div>
    </div>
</div>

@code {
    private DashboardViewMode ViewMode = DashboardViewMode.Profile;

    private string AppVersion =>
           //      Assembly.GetExecutingAssembly().GetName().Version?.ToString() ?? "0.0.0.0";
           Assembly.GetExecutingAssembly().GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "0.0.0.0";

    private UserInfo CurrentUserInfo { get; set; } = UserInfoExtensions.Empty;

    private void SetViewMode(DashboardViewMode mode)
        => ViewMode = mode;

    string OptionNoteText => ViewMode switch
    {
        DashboardViewMode.Profile =>
            "Option 1 active : la vue par profil remplace les cartes par une grille de type datagrid.",

        DashboardViewMode.PEX =>
            "Option 2 active : la vue par PEX regroupe les profils par environnement.",

        _ => string.Empty
    };

    private void HandleUserChanged(UserInfo? userInfo)
    {
        if (userInfo == null)
        {
            if (CurrentUserInfo.IsEmpty())
            {
                return;
            }
            CurrentUserInfo = UserInfoExtensions.Empty;
        }
        else
        {
            if (!CurrentUserInfo.IsEqual(userInfo))
            {
                CurrentUserInfo = userInfo;
            }
        }
    }

    private bool CanEdit()
    {
        var sab = new SABUnit();
        return sab.IsValidRole(CurrentUserInfo.Role);
    }

	// Start the notification service to listen to state updates    
    protected override async Task OnInitializedAsync()
    {
        await Notifications.StartAsync(Navigation);
    }
}