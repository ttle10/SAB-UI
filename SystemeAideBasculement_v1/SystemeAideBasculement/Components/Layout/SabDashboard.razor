@using SystemeAideBasculement.Components.Layout
@using SystemeAideBasculement.Components.Layout.Header
@using SystemeAideBasculement.Components.Layout.ProfileGrid
@using SystemeAideBasculement.Components.Layout.MemoGrid
@using SystemeAideBasculement.Services


<div class="dashboard-shell">
    <AppHeader ViewMode="@ViewMode" OnViewModeChanged="@SetViewMode" />

    <div class="content-row">
        <ProfilesPanel ViewMode="@ViewMode" />
        <MemoPanel />
    </div>

    <FooterBar />
    <OptionNote Text="@OptionNoteText" />
</div>

@code {
    private DashboardViewMode ViewMode = DashboardViewMode.Profile;

    void SetViewMode(DashboardViewMode mode)
        => ViewMode = mode;

    string OptionNoteText => ViewMode switch
    {
        DashboardViewMode.Profile =>
            "Option 1 active : la vue par profil remplace les cartes par une grille de type datagrid.",

        DashboardViewMode.PEX =>
            "Option 2 active : la vue par PEX regroupe les profils par environnement.",

        _ => string.Empty
    };
}