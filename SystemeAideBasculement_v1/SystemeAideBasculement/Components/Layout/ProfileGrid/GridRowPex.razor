@using SystemeAideBasculement.Models

<div class="grid-row" role="row">
    <div class="cell">
        <span class="profile-name">@Row.DisplayName</span>
    </div>

    <StatusCell Text="@Row.CCP.ProfileNames.Value" Connected="@IsConnected(Row.CCP.ProfileNames.Status)" />
    <StatusDot Value="@Row.CCP.CRA.Value" />
    <StatusDot Value="@Row.CCP.REU.Value" />
    <StatusDot Value="@Row.CCP.SGCZ.Value" />
    <StatusDot Value="@Row.CCP.STI.Value" />

    <StatusCell Text="@Row.CCR.ProfileNames.Value" Connected="@IsConnected(Row.CCR.ProfileNames.Status)" />
    <StatusDot Value="@Row.CCR.CRA.Value" />
    <StatusDot Value="@Row.CCR.REU.Value" />
    <StatusDot Value="@Row.CCR.SGCZ.Value" />
    <StatusDot Value="@Row.CCR.STI.Value" />
</div>

@code {
    [Parameter] public SabPexRow Row { get; set; } = default!;

    private static bool IsConnected(EndpointStatus status)
        => status == EndpointStatus.Connected;
}
