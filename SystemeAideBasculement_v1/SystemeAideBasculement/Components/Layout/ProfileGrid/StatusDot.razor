@using SystemeAideBasculement.Models

<div class="cell cell-center" role="gridcell">
    @if (NotMonitored)
    {
        <span class="dash">—</span>
    }
    else
    {
        <span class="dot @(string.IsNullOrWhiteSpace(Text) ? EndpointValue.None : Text)"></span>
    }
</div>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public bool NotMonitored { get; set; }
}