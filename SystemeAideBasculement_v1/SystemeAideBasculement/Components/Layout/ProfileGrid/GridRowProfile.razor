@using SystemeAideBasculement.Models

<div class="grid-row" role="row">
    <div class="cell">
        <span class="profile-name">@Row.DisplayName</span>
    </div>

    <StatusCell Text="@Row.CCP.PiccNames.Value" Connected="@IsConnected(Row.CCP.PiccNames.Status)" />
    <StatusDot Text="@Row.CCP.CRA.Value" NotMonitored="@IsNotMonitored(Row.CCP.CRA.Status)" />
    <StatusDot Text="@Row.CCP.REU.Value" NotMonitored="@IsNotMonitored(Row.CCP.REU.Status)" />
    <StatusDot Text="@Row.CCP.SGCZ.Value" NotMonitored="@IsNotMonitored(Row.CCP.SGCZ.Status)" />
    <StatusDot Text="@Row.CCP.STI.Value" NotMonitored="@IsNotMonitored(Row.CCP.STI.Status)" />

    <StatusCell Text="@Row.CCR.PiccNames.Value" Connected="@IsConnected(Row.CCR.PiccNames.Status)" />
    <StatusDot Text="@Row.CCR.CRA.Value" NotMonitored="@IsNotMonitored(Row.CCR.CRA.Status)" />
    <StatusDot Text="@Row.CCR.REU.Value" NotMonitored="@IsNotMonitored(Row.CCR.REU.Status)" />
    <StatusDot Text="@Row.CCR.SGCZ.Value" NotMonitored="@IsNotMonitored(Row.CCR.SGCZ.Status)" />
    <StatusDot Text="@Row.CCR.STI.Value" NotMonitored="@IsNotMonitored(Row.CCR.STI.Status)" />
</div>

@code {
    [Parameter] public SabProfileRow Row { get; set; } = default!;

    private static bool IsConnected(EndpointStatus status)
         => status == EndpointStatus.Connected;

    private static bool IsNotMonitored(EndpointStatus status)
         => status == EndpointStatus.NotMonitored;
}