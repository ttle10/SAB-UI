@using SystemeAideBasculement.Models

<div class="grid-row" role="row">
    <div class="cell">
        <span class="profile-name">@Row.Profile</span>
    </div>

    <StatusCell Text="@Row.CCP.PiccNames" Connected="@IsConnected(Row.CCP.PiccNames)" />
    <StatusDot Value="@Row.CCP.CRA" />
    <StatusDot Value="@Row.CCP.REU" />
    <StatusDot Value="@Row.CCP.SGCZ" />
    <StatusDot Value="@Row.CCP.STI" />

    <StatusCell Text="@Row.CCR.PiccNames" Connected="@IsConnected(Row.CCR.PiccNames)" />
    <StatusDot Value="@Row.CCR.CRA" />
    <StatusDot Value="@Row.CCR.REU" />
    <StatusDot Value="@Row.CCR.SGCZ" />
    <StatusDot Value="@Row.CCR.STI" />
</div>

@code {
    [Parameter] public SabProfileRow Row { get; set; } = default!;

    private static bool IsConnected(string? piccNames)
        => !string.IsNullOrWhiteSpace(piccNames) && !piccNames.Equals(EndpointValue.None, StringComparison.InvariantCultureIgnoreCase);
}