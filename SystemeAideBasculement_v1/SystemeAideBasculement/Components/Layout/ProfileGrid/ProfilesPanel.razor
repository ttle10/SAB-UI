@using SystemeAideBasculement.Components.Layout.ProfileGrid

<section class="panel">
    <div class="panel-heading">@ConnectedViewName connectés</div>

    <div class="grid-shell @(ViewMode == DashboardViewMode.PEX ? "pex-view" : "")">
        <GridHeader ViewMode="@ViewMode" />
        <GridBody ViewMode="@ViewMode" />
    </div>

    <Legend />
</section>

@code {
    [Parameter] public DashboardViewMode ViewMode { get; set; }

    private string ConnectedViewName { get; set; } = "Profils";

    protected override void OnParametersSet()
    {
        ConnectedViewName = ViewMode == DashboardViewMode.Profile ? "Profils" : "PEX";
    }
}