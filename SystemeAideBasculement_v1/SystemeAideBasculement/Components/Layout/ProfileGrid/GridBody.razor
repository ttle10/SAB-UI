@using SystemeAideBasculement.Components.Layout
@using SystemeAideBasculement.Models
@using SystemeAideBasculement.Services

@inject NavigationManager Navigation
@inject SabStateCache Cache
@inject NotificationService Notifications

@implements IAsyncDisposable


<div class="grid-body" role="grid">
    @if (ViewMode == DashboardViewMode.Profile)
    {
        @foreach (var row in Cache.Profiles)
        {
            <GridRowProfile @key="row.Profile"
                            Row="row" />
        }
    }
    else
    {
        @foreach (var row in Cache.Pexs)
        {
            <GridRowPex @key="row.DisplayName"
                        Row="row" />
        }
    }
</div>

@code {
    [Parameter] public DashboardViewMode ViewMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Notifications.OnStateUpdated += HandleStateUpdated;

        await Notifications.StartAsync(Navigation);
    }

    public async ValueTask DisposeAsync()
    {
        Notifications.OnStateUpdated -= HandleStateUpdated;
        await Notifications.DisposeAsync();
    }


    private void HandleStateUpdated(SabDataNotification update)
    {
        // Cache already update. Notify Blazor to re-render
        InvokeAsync(StateHasChanged);
    }
}