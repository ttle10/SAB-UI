@using SystemeAideBasculement.Models

<div class="cell cell-center" role="gridcell">
    <span class="status-badge @(Connected? StatusBadge.Connected: StatusBadge.Disconnected)">
        @(string.IsNullOrWhiteSpace(Text) ? EndpointValue.None : Text)
    </span>
</div>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public bool Connected { get; set; }
}