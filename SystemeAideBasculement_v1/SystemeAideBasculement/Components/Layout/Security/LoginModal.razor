@using SystemeAideBasculement.Services
@using SystemeAideBasculement.Services.Security
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json
@using System.Text.Json


@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="OnBackdropClick">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Connexion</h2>
            </div>

            <EditForm Model="Model" OnValidSubmit="HandleLogin">
                <div class="modal-body">

                    <div class="field">
                        <span>Nom d'utilisateur</span>
                        <InputText @ref="UsernameInput"
                                   @bind-Value="Model.Username"
                                   class="form-input" />
                    </div>

                    <div class="field">
                        <span>Mot de passe</span>
                        <InputText @bind-Value="Model.Password"
                                   type="password"
                                   class="form-input" />
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="error">@ErrorMessage</div>
                    }

                    <div class="modal-actions">
                        <button type="submit" class="btn-primary" disabled="@IsLoading">
                            @(IsLoading ? "Connexion..." : "Se connecter")
                        </button>
                        <button type="button" class="btn-secondary"
                                @onclick="Close"
                                disabled="@IsLoading">
                            Annuler
                        </button>
                    </div>

                </div>
            </EditForm>

        </div>
    </div>
}

@code {
    private bool _focused;

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnLoginSuccess { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private SabAuthStateProvider AuthProvider { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private ILogger<LoginModal> Logger { get; set; } = default!;

    private LoginModel Model { get; set; } = new();
    private string? ErrorMessage { get; set; } = null;
    private bool IsLoading { get; set; } = false;
    private InputText? UsernameInput { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_focused && UsernameInput?.Element.HasValue == true)
        {
            _focused = true;   // mark as done before awaiting
            await UsernameInput.Element.Value.FocusAsync();
        }
    }

    private async Task HandleLogin()
    {
        if (IsLoading) return;

        if (string.IsNullOrWhiteSpace(Model.Username) ||
            string.IsNullOrWhiteSpace(Model.Password))
        {
            ErrorMessage = "Veuillez entrer un nom d'utilisateur et un mot de passe.";
            return;
        }

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            // Call browser-side JS to send the HTTP request
            var result = await JS.InvokeAsync<LoginResult>(
                "sabAuth_login",
                Model.Username,
                Model.Password);

            if (result.Success)
            {
                var username = Model.Username;
                var role = result.Role ?? "CCSAB";

                // INFORME le provider → déclenche AuthenticationStateChanged
                AuthProvider.NotifyLogin(username, result.DisplayName ?? username, role);

                // fermer modal seulement
                await OnLoginSuccess.InvokeAsync(result.DisplayName ?? username);
            }
            else
            {
                ErrorMessage = result.Error ?? "Erreur de connexion.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "[SabUI:LoginModal:HandleLogin]: HTTP error for user '{Username}'",
                Model.Username);

            ErrorMessage = "Erreur de connexion au service d'authentification.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    // Adjust the record to match the JS return shape
    private record LoginResult(bool Success, string? DisplayName, string? Role, string? Error);

    private async Task Close()
    {
        Model = new();
        ErrorMessage = null;
        IsLoading = false;
        _focused = false;
        await OnClose.InvokeAsync();
    }

    private async Task OnBackdropClick()
    {
        if (!IsLoading)
            await Close();
    }

    private class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}