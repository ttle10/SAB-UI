@using SystemeAideBasculement.Services
@using SystemeAideBasculement.Services.Security
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json
@using System.Text.Json


@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="OnBackdropClick">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Connexion</h2>
            </div>

            <EditForm Model="_model" OnValidSubmit="HandleLogin">
                <div class="modal-body">

                    <div class="field">
                        <span>Nom d'utilisateur</span>
                        <InputText @ref="_usernameInput"
                                   @bind-Value="_model.Username"
                                   class="form-input" />
                    </div>

                    <div class="field">
                        <span>Mot de passe</span>
                        <InputText @bind-Value="_model.Password"
                                   type="password"
                                   class="form-input" />
                    </div>

                    @if (_errorMessage is not null)
                    {
                        <div class="error">@_errorMessage</div>
                    }

                    <div class="modal-actions">
                        <button type="submit" class="btn-primary" disabled="@_isLoading">
                            @(_isLoading ? "Connexion..." : "Se connecter")
                        </button>
                        <button type="button" class="btn-secondary"
                                @onclick="Close"
                                disabled="@_isLoading">
                            Annuler
                        </button>
                    </div>

                </div>
            </EditForm>

        </div>
    </div>
}

@code {
    private LoginModel _model = new();
    private string? _errorMessage;
    private bool _isLoading;
    private InputText? _usernameInput;
    private bool _focused;

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnLoginSuccess { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private ILogger<LoginModal> Logger { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_focused && _usernameInput?.Element.HasValue == true)
        {
            _focused = true;   // mark as done before awaiting
            await _usernameInput.Element.Value.FocusAsync();
        }
    }

    private async Task HandleLogin()
    {
        if (_isLoading) return;

        if (string.IsNullOrWhiteSpace(_model.Username) ||
            string.IsNullOrWhiteSpace(_model.Password))
        {
            _errorMessage = "Veuillez entrer un nom d'utilisateur et un mot de passe.";
            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            // Call browser-side JS to send the HTTP request
            var result = await JS.InvokeAsync<LoginResult>("sabAuth_login",
                _model.Username,
                _model.Password);
            if (!result.Success)
            {
                _errorMessage = result.Error ?? "Erreur de connexion.";
                return;
            }

            var ccsabGroup = new SABUnit();
            if (!ccsabGroup.IsValidRole(result.Role))
            {
                _errorMessage = "Vous n'avez pas les droits nécessaires.";
                return;
            }

            var displayName = result.DisplayName ?? _model.Username;

            // Full page reload so Blazor picks up the new auth cookie
            Nav.NavigateTo(Nav.Uri, forceLoad: true);

            await OnLoginSuccess.InvokeAsync(displayName);
            await Close();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "[SabUI:LoginModal:HandleLogin]: HTTP error for user '{Username}'",
                _model.Username);

            _errorMessage = "Erreur de connexion au service d'authentification.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Adjust the record to match the JS return shape
    private record LoginResult(bool Success, string? DisplayName, string? Role, string? Error);

    private async Task Close()
    {
        _model = new();
        _errorMessage = null;
        _isLoading = false;
        _focused = false;
        await OnClose.InvokeAsync();
    }

    private async Task OnBackdropClick()
    {
        if (!_isLoading)
            await Close();
    }

    private class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}