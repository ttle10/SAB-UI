@using SystemeAideBasculement.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json
@using System.Text.Json


@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="OnBackdropClick">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Connexion</h2>
            </div>

            <EditForm Model="model" OnValidSubmit="HandleLogin">
                <div class="modal-body">

                    <div class="field">
                        <span>Nom d'utilisateur</span>
                        <InputText @ref="_usernameInput"
                                   @bind-Value="model.Username"
                                   class="form-input" />
                    </div>

                    <div class="field">
                        <span>Mot de passe</span>
                        <InputText @bind-Value="model.Password"
                                   type="password"
                                   class="form-input" />
                    </div>

                    @if (errorMessage is not null)
                    {
                        <div class="error">@errorMessage</div>
                    }

                    <div class="modal-actions">
                        <button type="submit" class="btn-primary" disabled="@isLoading">
                            @(isLoading ? "Connexion..." : "Se connecter")
                        </button>
                        <button type="button" class="btn-secondary"
                                @onclick="Close"
                                disabled="@isLoading">
                            Annuler
                        </button>
                    </div>

                </div>
            </EditForm>

        </div>
    </div>
}

@code {
    private LoginModel model = new();
    private string? errorMessage;
    private bool isLoading;
    private InputText? _usernameInput;
    private bool _focused;

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnLoginSuccess { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private ILogger<LoginModal> Logger { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_focused && _usernameInput?.Element.HasValue == true)
        {
            _focused = true;   // mark as done before awaiting
            await _usernameInput.Element.Value.FocusAsync();
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(model.Username) ||
            string.IsNullOrWhiteSpace(model.Password))
        {
            errorMessage = "Veuillez entrer un nom d'utilisateur et un mot de passe.";
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            // Call browser-side JS to send the HTTP request
            var result = await JS.InvokeAsync<LoginResult>("sabAuth.login",
                model.Username,
                model.Password);

            if (result.Success)
            {
                var displayName = result.DisplayName ?? model.Username;

                // Full page reload so Blazor picks up the new auth cookie
                Nav.NavigateTo(Nav.Uri, forceLoad: true);

                await OnLoginSuccess.InvokeAsync(displayName);
                await Close();
            }
            else
            {
                errorMessage = result.Error ?? "Erreur de connexion.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "[SabUI:LoginModal:HandleLogin]: HTTP error for user '{Username}'",
                model.Username);

            errorMessage = "Erreur de connexion au service d'authentification.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Adjust the record to match the JS return shape
    private record LoginResult(bool Success, string? DisplayName, string? groupName, string? Error);

    private async Task Close()
    {
        model = new();
        errorMessage = null;
        isLoading = false;
        _focused = false;
        await OnClose.InvokeAsync();
    }

    private async Task OnBackdropClick()
    {
        if (!isLoading)
            await Close();
    }

    private class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}