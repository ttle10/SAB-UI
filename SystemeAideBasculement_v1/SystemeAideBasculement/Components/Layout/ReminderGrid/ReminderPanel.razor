@using SystemeAideBasculement.Components.Layout.ReminderGrid
@using SystemeAideBasculement.Shared
@using SystemeAideBasculement.Models

<section class="panel-reminder">

    <AideMemoireHeader @ref="_headerCtrl" />
    <AideMemoire CurrentUserInfo="@CurrentUserInfo"
                 OnLoading="@(HandleIsLoading)"
                 OnRaiseError="@HandleRaiseError"
                 @ref="_aidememoireCtrl" />
    <div />
	<ReminderToolbar CurrentUserInfo="@CurrentUserInfo"
                    OnResetReminderSteps="@ResetSteps"/>
</section>
@code {
    [Parameter] public UserInfo CurrentUserInfo { get; set; } = UserInfoExtensions.Empty;

    private AideMemoireHeader? _headerCtrl;
    private AideMemoire? _aidememoireCtrl;

    private async Task ResetSteps()
    {
        if (_aidememoireCtrl != null)
        {
            await _aidememoireCtrl.ResetSteps();
        }
    }

    private void HandleIsLoading(bool isLoading)
    {
        if (_headerCtrl != null)
        {
            ICustomMessage? message = null;
            if (isLoading)
            {
                message = new InfoException("En chargement…");
            }
            _headerCtrl.SetMessage(message);
        }        
        //StateHasChanged();
	}

    private void HandleRaiseError(ICustomMessage? ex)
    {
        if (_headerCtrl != null)
        {
            _headerCtrl.SetMessage(ex);
        }
        //StateHasChanged();
    }
}