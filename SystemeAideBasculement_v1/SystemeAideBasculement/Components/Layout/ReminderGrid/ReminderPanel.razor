@using SystemeAideBasculement.Components.Layout.ReminderGrid
@using SystemeAideBasculement.Shared

<section class="panel">
    <AideMemoire CanEdit="@CanEdit"
                 @ref="_aidememoireCtrl" />
    <div />
    <ReminderToolbar CanEdit="@CanEdit"
                 OnResetReminderSteps="ResetSteps" />
</section>
@code {
    [Parameter] public bool CanEdit { get; set; } = false;

    private AideMemoire? _aidememoireCtrl;

    private async Task ResetSteps()
    {
        if (_aidememoireCtrl != null)
        {
            await _aidememoireCtrl.ResetSteps();
        }
    }
}