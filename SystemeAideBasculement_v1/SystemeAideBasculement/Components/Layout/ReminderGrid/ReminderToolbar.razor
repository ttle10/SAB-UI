@using SystemeAideBasculement.Shared
@using SystemeAideBasculement.Components.Layout.Common

<div class="reminder-toolbar">
    <div class="reminder-toolbar-left">
        <ButtonAction DisplayText="Réinitialiser étapes"
                      TooltipText="Réinitialiser les étapes à leur état par défaut"   
                      CanEdit="@CurrentUserInfo.IsValidRole()"
                      OnClick="@OnResetReminderSteps" />
        @* Future buttons go here *@
    </div>
</div>

@code {
    [Parameter] public UserInfo CurrentUserInfo { get; set; } = UserInfoExtensions.Empty;

    [Parameter] public EventCallback OnResetReminderSteps { get; set; }
}