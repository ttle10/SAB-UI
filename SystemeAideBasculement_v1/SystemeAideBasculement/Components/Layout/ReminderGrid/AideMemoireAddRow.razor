@using SystemeAideBasculement.Components.Layout.Common
@using SystemeAideBasculement.Models

<tr>
    @if (AjoutEnCours)
    {
        <td class="drag-handle"/>
        <!-- Étape -->
        <td class="col-step">
            <AutoResizeTextarea Value="@NouvelleEtape"
                                ValueChanged="@NouvelleEtapeChanged"
                                MaxLength="@AideMemoireModel.StepMaxLength"
                                Placeholder="Nouvelle étape..."
                                ShowCounter="@false"
                                OnEditMode="@true"
                                OnCtrlEnter="@AddIfValid" />
        </td>
        <!-- Complété -->
        <td class="col-completed"/>
        <!-- Initiales -->
        <td class="col-initials"/>
        <!-- Actions -->
        <td class="col-actions">
            <ButtonIconAction DisplayText="💾"
                              TooltipText="Sauvegarder l'ajout"
                              CanEdit="@(!string.IsNullOrWhiteSpace(NouvelleEtape))"
                              OnClick="@AddIfValid" />
            <ButtonIconAction DisplayText="✖"
                              TooltipText="Annuler l'ajout"
                              CanEdit="@true"
                              OnClick="@OnCancelAdd" />
        </td>
    }
    else
    {
        <td colspan="5">
            <ButtonAction DisplayText="Ajouter une nouvelle étape…"
                          TooltipText="Ajouter une nouvelle étape à l'aide-mémoire"
                          CanEdit="@CanEdit"
                          OnClick="@OnStartAdd" />
        </td>
    }
</tr>

@code {
    [Parameter] public bool AjoutEnCours { get; set; }
    [Parameter] public string NouvelleEtape { get; set; } = "";
    [Parameter] public bool CanEdit { get; set; }

    [Parameter] public EventCallback OnStartAdd { get; set; }
    [Parameter] public EventCallback OnCancelAdd { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public EventCallback<string?> NouvelleEtapeChanged { get; set; }


    private async Task AddIfValid()
    {
        if (!CanEdit)
            return;

        if (string.IsNullOrWhiteSpace(NouvelleEtape))
            return;

        await OnAdd.InvokeAsync();
    }
}