@using SystemeAideBasculement.Models
@using SystemeAideBasculement.Components.Layout.Common
@using Microsoft.EntityFrameworkCore

@inject SystemeAideBasculement.Context.AideMemoireDbContext Db

<div class="aide-memoire-layout">
    <AideMemoireHeader IsLoading="@(_etapes == null)" />
    <AideMemoireTable Etapes="@(_etapes ?? new List<AideMemoireVm>())"
                      IsLoading="@(_etapes == null)"
                      EtapeEnEdition="@_etapeEnEdition"
                      AjoutEnCours="@_ajoutEnCours"
                      NouvelleEtape="@_nouvelleEtape"
				      CanEdit="@CanEdit"
                      OnEdit="@HandleModifierEtape"
                      OnCancelEdit="@AnnulerEdition"
                      OnSave="@SauvegarderEtape"
                      OnDelete="@ConfirmerSuppression"
                      OnStartAdd="@CommencerAjout"
                      OnCancelAdd="@AnnulerAjout"
                      OnAdd="@AjouterEtape"
                      NouvelleEtapeChanged="@(v => _nouvelleEtape = v)" />
    <ConfirmDialog @ref="_confirmDialog" />
</div>


@code {
    [Parameter] public bool CanEdit { get; set; } = false;

    private List<AideMemoireVm>? _etapes;
    private AideMemoireVm? _etapeEnEdition;
    private string _nouvelleEtape = string.Empty;
    private bool _ajoutEnCours;
    private ConfirmDialog? _confirmDialog;


    protected override async Task OnInitializedAsync()
    {
        await RechargerEtapes();
    }

    private async Task RechargerEtapes()
    {
        _etapes = null; // explicit loading state

        _etapes = await Db.AideMemoires
                    .Where(e => !e.IsDeleted)
                    .OrderBy(e => e.Id)
                    .Select(e => e.ToVm())
                    .ToListAsync();

        _etapeEnEdition = null;
    }

    private void HandleModifierEtape(AideMemoireVm etape) =>
        _etapeEnEdition = new AideMemoireVm(etape);

    private void AnnulerEdition() => _etapeEnEdition = null;

    private async Task SauvegarderEtape(AideMemoireVm? etape)
    {
        if (etape == null) return;
        var original = await Db.AideMemoires.FindAsync(etape.Id);
        if (original != null)
        {
            original.Step = etape.Step;
            original.Initials = etape.Initials;
            original.IsCompleted = etape.IsCompleted;
            await Db.SaveChangesAsync();
            await RechargerEtapes();
        }
    }

    private async Task ConfirmerSuppression(AideMemoireVm etape)
    {
        var confirm = await _confirmDialog!.ShowAsync(
            "Confirmation",
            $"Supprimer l'étape '{etape.Step}' ?"
        );

        if (confirm)
        {
            var original = await Db.AideMemoires.FindAsync(etape.Id);
            if (original != null)
            {
                original.IsDeleted = true;
                await Db.SaveChangesAsync();
                await RechargerEtapes();
            }
        }
    }

