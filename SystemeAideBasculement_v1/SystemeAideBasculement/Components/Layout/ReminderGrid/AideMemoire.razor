@using SystemeAideBasculement.Models
@using SystemeAideBasculement.Components.Layout.Common
@using SystemeAideBasculement.Services

@implements IAsyncDisposable

<AideMemoireTable Etapes="@(_etapes ?? new List<AideMemoireVm>())"
                    IsLoading="@_isLoading"
                    EtapeEnEdition="@_etapeEnEdition"
                    AjoutEnCours="@_ajoutEnCours"
                    NouvelleEtape="@_nouvelleEtape"
				    CanEdit="@CanEdit"
                    OnEdit="@HandleModifierEtape"
                    OnCancelEdit="@AnnulerEdition"
                    OnSave="@SauvegarderEtape"
                    OnDelete="@ConfirmerSuppression"
                    OnStartAdd="@CommencerAjout"
                    OnCancelAdd="@AnnulerAjout"
                    OnAdd="@AjouterEtape"
                    NouvelleEtapeChanged="@(v => _nouvelleEtape = v)" />
<ConfirmDialog @ref="_confirmDialog" />

@code {
    [Parameter] public bool CanEdit { get; set; } = false;
    [Parameter] public EventCallback<bool> OnLoading { get; set; }
    [Parameter] public EventCallback<string> OnRaiseError { get; set; }

    [Inject] private ILogger<AideMemoire> Logger { get; set; } = default!;
    [Inject] private IAideMemoireRepository Service { get; set; } = default!;

    [Inject] private NotificationService Notifications { get; set; } = default!;


    private List<AideMemoireVm>? _etapes;
    private AideMemoireVm? _etapeEnEdition;
    private string _nouvelleEtape = string.Empty;
    private bool _ajoutEnCours;
    private bool _isLoading;

    private string? _errorMessage = null;

    private ConfirmDialog? _confirmDialog;


    protected override async Task OnInitializedAsync()
    {
        Notifications.OnReminderChanged += HandleReminderChanged;
        await RechargerEtapes();
    }

    public ValueTask DisposeAsync()
    {
        Notifications.OnReminderChanged -= HandleReminderChanged;
        return ValueTask.CompletedTask;
    }

    public async Task ResetSteps()
    {
        var confirm = await _confirmDialog!.ShowAsync(
            "Confirmation",
            $"Voulez-vous réinitialiser le suivi des étapes ?"
        );

        if (!confirm) return;


        _errorMessage = null;

        try
        {
            await Service.ResetAllAsync();

        }
        catch (Exception ex)
        {
            _errorMessage = "Erreur lors de la réinitialisation des étapes.";
            Logger.LogError(ex, "[SabUI:AideMemoire:ResetSteps]: {_errorMessage}");
            await OnRaiseError.InvokeAsync(_errorMessage);
        }
        finally
        {
            await RechargerEtapes();
            StateHasChanged();
        }
    }

    private void HandleReminderChanged()
    {
        InvokeAsync(async () =>
        {
            await RechargerEtapes();
            StateHasChanged();
        });
	}

    private async Task RechargerEtapes()
    {
        // Security in case of loading not done
        if (_isLoading)
            return;

        _isLoading = true;
        await OnLoading.InvokeAsync(true);
        _etapes = null; // explicit loading state

        try
        {
            _etapes = await Service.GetAllAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Erreur lors du chargement.";
            Logger.LogError(ex, $"[SabUI:AideMemoire:RechargerEtapes]: {_errorMessage}.");
            await OnRaiseError.InvokeAsync(_errorMessage);
        }
        finally
        {
            _isLoading = false;
        }
        await OnLoading.InvokeAsync(false);
        _etapeEnEdition = null;
    }

    private void HandleModifierEtape(AideMemoireVm etape) =>
        _etapeEnEdition = new AideMemoireVm(etape);

    private void AnnulerEdition() => _etapeEnEdition = null;

    private async Task SauvegarderEtape(AideMemoireVm? etape)
    {
        if (etape == null) return;

        try
        {
            await Service.UpdateAsync(etape);
        }
        catch (Exception ex)
        {
            _errorMessage = "Erreur lors de la sauvegarde de l'étape.";
            Logger.LogError(ex, $"[SabUI:AideMemoire:SauvegarderEtape]: {_errorMessage}.");
            await OnRaiseError.InvokeAsync(_errorMessage);
        }
        finally
        {
            _etapeEnEdition = null;
            await RechargerEtapes();
        }
    }

    private async Task ConfirmerSuppression(AideMemoireVm etape)
    {
        var confirm = await _confirmDialog!.ShowAsync(
            "Confirmation",
            $"Supprimer l'étape '{etape.Step}' ?"
        );

        if (!confirm)
        {
			return;
        }

        try
        {
            await Service.SoftDeleteAsync(etape.Id);
        }
        catch (Exception ex)
        {
            _errorMessage = "Erreur lors de la suppression de l'étape.";
            Logger.LogError(ex, $"[SabUI:AideMemoire:ConfirmerSuppression]: {_errorMessage}.");
            await OnRaiseError.InvokeAsync(_errorMessage);
        }
        finally
        {
            await RechargerEtapes();
		}
    }

    private void CommencerAjout() => _ajoutEnCours = true;

    private void AnnulerAjout()
    {
        _ajoutEnCours = false;
		_nouvelleEtape = string.Empty;
    }
    

    private async Task AjouterEtape()
    {
        if (string.IsNullOrWhiteSpace(_nouvelleEtape))
        {
            return;
        }

        try
        {
            await Service.AddAsync(_nouvelleEtape);
        }
        catch (Exception ex)
        {
            _errorMessage = "Erreur lors de l'ajout de l'étape.";
            Logger.LogError(ex, $"[SabUI:AideMemoire:AjouterEtape]: {_errorMessage}.");
            await OnRaiseError.InvokeAsync(_errorMessage);
        }
        finally
        {
            _nouvelleEtape = string.Empty;
            _ajoutEnCours = false;
            await RechargerEtapes();
        }
    }
}