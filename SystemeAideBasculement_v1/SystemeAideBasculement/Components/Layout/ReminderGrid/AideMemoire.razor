@inject IJSRuntime JS
@inject SystemeAideBasculement.Context.AideMemoireDbContext Db
@using SystemeAideBasculement.Models
@using Microsoft.EntityFrameworkCore

<div class="aide-memoire-layout">
<AideMemoireHeader IsLoading="_etapes == null" />

<AideMemoireTable Etapes="_etapes ?? new List<AideMemoireModel>()"
                  IsLoading="_etapes == null"
                  EtapeEnEdition="etapeEnEdition"
                  AjoutEnCours="ajoutEnCours"
                  NouvelleEtape="nouvelleEtape"
				  CanEdit="CanEdit"
                  OnEdit="ModifierEtape"
                  OnCancelEdit="AnnulerEdition"
                  OnSave="SauvegarderEtape"
                  OnDelete="ConfirmerSuppression"
                  OnStartAdd="CommencerAjout"
                  OnCancelAdd="AnnulerAjout"
                  OnAdd="AjouterEtape"
                  NouvelleEtapeChanged="v => nouvelleEtape = v" />
</div>
@code {
    [Parameter] public bool CanEdit { get; set; } = false;

    private List<AideMemoireModel>? _etapes;
    private AideMemoireModel? etapeEnEdition;
    private string nouvelleEtape = string.Empty;
    private bool ajoutEnCours;

    protected override async Task OnInitializedAsync()
    {
        await RechargerEtapes();
    }

    private async Task RechargerEtapes()
    {
        _etapes = null; // explicit loading state

        _etapes = await Db.AideMemoires
            .Where(e => !e.IsDeleted)
            .OrderBy(e => e.Id)
            .ToListAsync();

        etapeEnEdition = null;
    }

    private void ModifierEtape(AideMemoireModel etape) =>
        etapeEnEdition = new AideMemoireModel
        {
            Id = etape.Id,
            Step = etape.Step,
            Initials = etape.Initials,
            IsCompleted = etape.IsCompleted,
            IsDeleted = etape.IsDeleted
        };

    private void AnnulerEdition() => etapeEnEdition = null;

    private async Task SauvegarderEtape(AideMemoireModel? etape)
    {
        if (etape == null) return;
        var original = await Db.AideMemoires.FindAsync(etape.Id);
        if (original != null)
        {
            original.Step = etape.Step;
            original.Initials = etape.Initials;
            original.IsCompleted = etape.IsCompleted;
            await Db.SaveChangesAsync();
            await RechargerEtapes();
        }
    }

    private async Task ConfirmerSuppression(AideMemoireModel etape)
    {
        if (await JS.InvokeAsync<bool>("confirm",
            $"Voulez-vous vraiment supprimer l'étape '{etape.Step}' ?"))
        {
            var original = await Db.AideMemoires.FindAsync(etape.Id);
            if (original != null)
            {
                original.IsDeleted = true;
                await Db.SaveChangesAsync();
                await RechargerEtapes();
            }
        }
    }

