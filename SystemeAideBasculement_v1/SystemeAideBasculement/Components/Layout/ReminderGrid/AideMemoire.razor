@using SystemeAideBasculement.Shared
@using SystemeAideBasculement.Models
@using SystemeAideBasculement.Components.Layout.Common
@using SystemeAideBasculement.Services


@implements IAsyncDisposable

<AideMemoireTable CanEdit="@CanEdit"
                  Etapes="@(_etapes ?? new List<AideMemoireVm>())"
                  IsLoading="@_isLoading"
                  EtapeEnEdition="@_etapeEnEdition"
                  AjoutEnCours="@_ajoutEnCours"
                  OnEdit="@HandleModifierEtape"
                  OnCancelEdit="@AnnulerEdition"
                  OnSave="@SauvegarderEtape"
                  OnDelete="@ConfirmerSuppression"
                  OnStartAdd="@CommencerAjout"
                  OnCancelAdd="@AnnulerAjout"
                  OnAdd="@AjouterEtape"
                  OnUpdateDisplayOrderEtape="@HandleReorderDisplayEtape"
                  OnStartDrag="@HandleStartDrag"
                  OnCancelDrag="@HandleCancelDrag"/>
<ConfirmDialog @ref="_confirmDialog" />

@code {
    [Parameter] public UserInfo CurrentUserInfo { get; set; } = UserInfoExtensions.Empty;
    [Parameter] public EventCallback<bool> OnLoading { get; set; }
    [Parameter] public EventCallback<ICustomMessage> OnRaiseError { get; set; }

    [Inject] private ILogger<AideMemoire> Logger { get; set; } = default!;
    [Inject] private IAideMemoireRepository Service { get; set; } = default!;

    [Inject] private NotificationService Notifications { get; set; } = default!;

    private ConfirmDialog? _confirmDialog;

    private List<AideMemoireVm>? _etapes;
    private AideMemoireVm? _etapeEnEdition;
    private bool _ajoutEnCours;
    private bool _isLoading;

    private Guid _initiator = Guid.NewGuid(); // Unique identifier for Initiator data access command


    // Drag & Drop process variable
    private List<AideMemoireVm>? _etapesBeforeDrag;

	private bool CanEdit => CurrentUserInfo.IsValidRole();


    protected override async Task OnInitializedAsync()
    {
        Notifications.OnReminderChanged += HandleReminderChanged;
        await RechargerEtapes();
    }

    public ValueTask DisposeAsync()
    {
        Notifications.OnReminderChanged -= HandleReminderChanged;
        return ValueTask.CompletedTask;
    }

    public async Task ResetSteps()
    {
        var confirm = await _confirmDialog!.ShowAsync(
            "Confirmation",
            $"Voulez-vous réinitialiser le suivi des étapes ?"
        );

        if (!confirm) return;


        try
        {
            await Service.ResetAllAsync(_initiator);

        }
        catch (Exception ex)
        {
            var error = new ErrorException("Erreur lors de la réinitialisation des étapes.");
            Logger.LogError(ex, "[SabUI:AideMemoire:ResetSteps]: {error.DisplayMessage}");
            await OnRaiseError.InvokeAsync(error);
        }
        finally
        {
            await RechargerEtapes();
            StateHasChanged();
        }
    }

    private void HandleReminderChanged(Guid initiator)
    {
        InvokeAsync(async () =>
        {
            if (initiator == _initiator)
            {
                // Ignore changes initiated by this component
                return;
            }
            if (_isLoading)
            {
                // If we're currently loading, we can skip this notification to avoid redundant reloads
                return;
            }
            await RechargerEtapes();
            await OnRaiseError.InvokeAsync(new WarningException("Un utilisateur a mis à jour les données. Veuillez réviser les étapes."));
            //StateHasChanged();
        });
    }

    private async Task RechargerEtapes()
    {
        // Security in case of loading not done
        if (_isLoading)
            return;

        _isLoading = true;
        //await OnLoading.InvokeAsync(true);
        _etapes = null; // explicit loading state

        try
        {
            _etapes = await Service.GetAllAsync();
        }
        catch (Exception ex)
        {
            var error = new ErrorException("Erreur lors du chargement.");
            Logger.LogError(ex, $"[SabUI:AideMemoire:RechargerEtapes]: {error.DisplayMessage}.");
            await OnRaiseError.InvokeAsync(error);
        }
        finally
        {
            _isLoading = false;
        }
        // await OnLoading.InvokeAsync(false);
        _etapeEnEdition = null;
    }

    private void HandleModifierEtape(AideMemoireVm etape) =>
        _etapeEnEdition = new AideMemoireVm(etape);

    private void AnnulerEdition() => _etapeEnEdition = null;

    private async Task SauvegarderEtape(AideMemoireVm? etape)
    {
        if (etape == null) return;

        try
        {
            await Service.UpdateAsync(etape, _initiator);
        }
        catch (Exception ex)
        {
            var error = new ErrorException("Erreur lors de la sauvegarde de l'étape.");
            Logger.LogError(ex, $"[SabUI:AideMemoire:SauvegarderEtape]: {error.DisplayMessage}.");
            await OnRaiseError.InvokeAsync(error);
        }
        finally
        {
            _etapeEnEdition = null;
            await RechargerEtapes();
        }
    }

    private async Task ConfirmerSuppression(AideMemoireVm etape)
    {
        var confirm = await _confirmDialog!.ShowAsync(
            "Confirmation",
            $"Supprimer l'étape '{etape.Step}' ?"
        );

        if (!confirm)
        {
            return;
        }

        try
        {
            await Service.SoftDeleteAsync(etape.Id, _initiator);
        }
        catch (Exception ex)
        {
            var error = new ErrorException("Erreur lors de la suppression de l'étape.");
            Logger.LogError(ex, $"[SabUI:AideMemoire:ConfirmerSuppression]: {error.DisplayMessage}.");
            await OnRaiseError.InvokeAsync(error);
        }
        finally
        {
            await RechargerEtapes();
        }
    }

    private void CommencerAjout() => _ajoutEnCours = true;

    private void AnnulerAjout()
    {
        _ajoutEnCours = false;
    }

    private async Task AjouterEtape(string nouvelleEtape)
    {
        if (string.IsNullOrWhiteSpace(nouvelleEtape))
        {
            return;
        }

        try
        {
            await Service.AddAsync(nouvelleEtape, _initiator);
        }
        catch (Exception ex)
        {
            var error = new ErrorException("Erreur lors de l'ajout de l'étape.");
            Logger.LogError(ex, $"[SabUI:AideMemoire:AjouterEtape]: {error.DisplayMessage}.");
            await OnRaiseError.InvokeAsync(error);
        }
        finally
        {
            _ajoutEnCours = false;
            await RechargerEtapes();
        }
    }

    private async Task HandleReorderDisplayEtape(List<AideMemoireVm> reorderedEtapes)
    {
        try
        {
            await Service.UpdateDisplayOrderAsync(reorderedEtapes, _initiator);
        }
        catch (Exception ex)
        {
            var error = new ErrorException("Erreur lors de la mise à jour de l'ordre d'affichage.");
            Logger.LogError(ex, $"[SabUI:AideMemoire:HandleReorderDisplayEtape]: {error.DisplayMessage}.");
            await OnRaiseError.InvokeAsync(error);
        }
        finally
        {
            if (_etapesBeforeDrag != null)
                _etapesBeforeDrag = null;
            await RechargerEtapes();
        }
    }

    private void HandleStartDrag()
    {
        _etapesBeforeDrag = _etapes != null ? new List<AideMemoireVm>(_etapes) : null; // Sauvegarde de l'état avant drag
    }

    private void HandleCancelDrag()
    {
        if (_etapesBeforeDrag != null)
        {
            _etapes = _etapesBeforeDrag; // Restaure l'état avant drag
            _etapesBeforeDrag = null;
            StateHasChanged();
        }
	}

    private void HandleEndDrag()
    {
        if (_etapesBeforeDrag != null)
        {
            _etapesBeforeDrag = null;
        }
    }
}