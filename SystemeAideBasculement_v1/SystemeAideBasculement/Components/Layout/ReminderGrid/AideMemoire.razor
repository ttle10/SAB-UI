   //              await RechargerEtapes();
   //          }
   //      }
   //  }


    private void CommencerAjout() => ajoutEnCours = true;
    private void AnnulerAjout() => ajoutEnCours = false;

    private async Task AjouterEtape()
    {
        if (!string.IsNullOrWhiteSpace(nouvelleEtape))
        {
            Db.AideMemoires.Add(new() { Step = nouvelleEtape });
            await Db.SaveChangesAsync();
            nouvelleEtape = string.Empty;
            ajoutEnCours = false;
            await RechargerEtapes();
        }
    }
}