@using SystemeAideBasculement.Models
@using SystemeAideBasculement.Shared
@using SystemeAideBasculement.Components.Layout.Common


<tr class="draggable-row @(IsDragging ? "dragging" : "")"
    @onmouseenter="() => HandleRowEnter(Etape)"
    @onmouseup="HandleEndDrag">
    <!--  @ondragstart="(e) => OnDragStart(Etape, e)" -->
    <td class="drag-handle @(CanDrag ? "" : "disabled")">
        @if (CanDrag)
        {
            <span style="cursor: grab;"
                  title="Réordonner l'étape"
                  @onmousedown="() => StartDrag(Etape)"
                  @onmouseup="() => StartDrag(Etape)">
                  ☰≡⋮⋮
            </span>
        }
    </td>
    <!-- Étape -->
    <td class="col-step aide-memoire-cell">
        @if (CanEdit && IsEtapeInEdition())
        {
            <AutoResizeTextarea Value="@EtapeEnEdition!.Step"
                                ValueChanged="@(v => EtapeEnEdition!.Step = v)"
                                MaxLength="@AideMemoireModel.StepMaxLength"
                                ShowCounter="@false"
								OnEditMode="@true"
                                OnCtrlEnter="@HandleOnSaveEditEtape" />
        }
        else
        {
            if (IsEtapeInEdition())
            {
                _ = InvokeAsync(async () =>
                {
                    await HandleOnCancelEditEtape();
                });
            }
            @Etape.Step
        }
    </td>
    <!-- Complété (TOUJOURS éditable) -->
    <td class="col-completed">
        <input type="checkbox"
               disabled="@(!CanEditEtape || !CanEdit)"
                checked="@Etape.IsCompleted"
                @ref="_completedCheck"
                @onchange="OnCompletedChanged" />
    </td>
    <!-- Initials (TOUJOURS éditable) -->
    <td class="col-initials">
        <InputTextValue Value="@Etape.Initials"
                        MaxLength="7"
                        CanEdit="@(CanEditEtape && CanEdit)"
                        @ref="_initialesInput"
                        ValueChanged="@(v => Etape.Initials = v)"
                        OnLostFocus="HandleOnLostFocus"
                        OnEnterKey="HandleOnEnterKey" />
    </td>
    <!-- Actions -->
    <td class="col-actions">
        @if (Etape.Id == EtapeEnEdition?.Id)
        {
            <ButtonIconAction DisplayText="💾"
                            TooltipText="Sauvegarder les modifications"
                            CanEdit="@CanEdit"
                            OnClick="@HandleOnSaveEditEtape" />
            <ButtonIconAction DisplayText="✖"
                              TooltipText="Annuler les modifications"
                              CanEdit="@true"
                              OnClick="@HandleOnCancelEditEtape" />
        }
        else
        {
            <ButtonIconAction DisplayText="✎"
                              TooltipText="Modifier l'étape"
                              CanEdit="@(CanEdit && CanEditEtape)"
                              OnClick="@HandleOnEditEtape" />
            <ButtonIconAction DisplayText="🗑"
                              TooltipText="Supprimer l'étape"
                              CanEdit="@(CanEdit && CanEditEtape)"
                              OnClick="@HandleOnDeleteEtape" />
        }
    </td>
</tr>

@code {
    [Parameter] public bool CanEdit { get; set; } = false;

    [Parameter] public AideMemoireVm Etape { get; set; } = default!;
    [Parameter] public AideMemoireVm? EtapeEnEdition { get; set; }
    
    [Parameter] public EventCallback<AideMemoireVm> OnEdit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<AideMemoireVm?> OnSave { get; set; }
    [Parameter] public EventCallback<AideMemoireVm> OnDelete { get; set; }
    [Parameter] public bool CanEditEtape { get; set; } = false;

    // Drag & Drop parameters
    // Ces variables sont injectées depuis le parent (voir plus bas)
    [Parameter] public AideMemoireVm? _draggingItem { get; set; }
    [Parameter] public EventCallback<AideMemoireVm> OnStartDrag { get; set; }
    [Parameter] public EventCallback<AideMemoireVm> OnRowHover { get; set; }
    [Parameter] public EventCallback<AideMemoireVm> OnEndDrag { get; set; }


    private InputTextValue? _initialesInput;
    private ElementReference _completedCheck;

	private bool CanDrag => CanEdit && CanEditEtape;


    private async Task OnCompletedChanged(ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;

        // Some browsers send "true"/"false" as string
        if (!isChecked && e.Value is string s && bool.TryParse(s, out var parsed))
        {
            isChecked = parsed;
        }

        Etape.IsCompleted = isChecked;
        // Persist change via parent save callback
        await OnSave.InvokeAsync(Etape);

        // If user tries to mark as completed without initials → block and focus input
        if (isChecked && string.IsNullOrWhiteSpace(Etape.Initials))
        {
            // Move cursor to initials field
            if (_initialesInput != null)
                await _initialesInput.SetFocus();
        }
    }

    private async Task HandleOnLostFocus(string value)
    {
        Etape.Initials = value;
        await Save();
    }

    private async Task HandleOnEnterKey()
    {
        // User Hit Enter key, save Etape
        await Save();
    }

    // This is used to apply specific CSS class to the row being dragged
    private bool IsDragging => _draggingItem != null && _draggingItem.Id == Etape.Id;

    private Task StartDrag(AideMemoireVm etape)
    {
        if (!(CanEdit && CanEditEtape))
            return Task.CompletedTask;

        return  OnStartDrag.InvokeAsync(etape);
    }

    private Task HandleRowEnter(AideMemoireVm etape)
    {
        if (!(CanEdit && CanEditEtape))
            return Task.CompletedTask;

        return OnRowHover.InvokeAsync(etape);
    }

    private Task HandleEndDrag()
    {
        if (!(CanEdit && CanEditEtape))
            return Task.CompletedTask;

        return OnEndDrag.InvokeAsync();
    }

    private async Task Save()
    {
        // User left the field — now validate and save
        if (!string.IsNullOrWhiteSpace(Etape.Initials))
        {
            Etape.IsCompleted = true;
        }

        await OnSave.InvokeAsync(Etape);
    }

    private bool IsEtapeInEdition() => EtapeEnEdition?.Id == Etape.Id;

    private async Task HandleOnSaveEditEtape()
    {
        await OnSave.InvokeAsync(EtapeEnEdition);
        EtapeEnEdition = null;
    }

    private async Task HandleOnCancelEditEtape()
    {
        await OnCancel.InvokeAsync();
        EtapeEnEdition = null;
    }

    private async Task HandleOnEditEtape()
    {
        await OnEdit.InvokeAsync(Etape);
    }

    private async Task HandleOnDeleteEtape()
    {
        await OnDelete.InvokeAsync(Etape);
    }
}